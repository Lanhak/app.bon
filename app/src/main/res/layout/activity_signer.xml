<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="MTool Signer"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnPickApk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chọn APK đầu vào"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvApk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chưa chọn APK"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/btnPickApk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <Button
        android:id="@+id/btnPickKeystore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chọn keystore (.jks/.p12)"
        app:layout_constraintTop_toBottomOf="@id/tvApk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvKeystore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chưa chọn keystore"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/btnPickKeystore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAlias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Alias (để trống = tự chọn alias đầu tiên)"
        app:layout_constraintTop_toBottomOf="@id/tvKeystore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAlias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilKsPass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Mật khẩu keystore"
        app:layout_constraintTop_toBottomOf="@id/tilAlias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKsPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilKeyPass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Mật khẩu key (nếu khác keystore)"
        app:layout_constraintTop_toBottomOf="@id/tilKsPass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKeyPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnPickOutput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chọn nơi lưu APK đã ký"
        app:layout_constraintTop_toBottomOf="@id/tilKeyPass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chưa chọn nơi lưu"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/btnPickOutput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <Button
        android:id="@+id/btnSign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ký APK"
        app:layout_constraintTop_toBottomOf="@id/tvOutput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/btnClearKey"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Đăng xuất (xoá key)"
        app:layout_constraintTop_toBottomOf="@id/btnSign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Trạng thái: sẵn sàng"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btnClearKey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

